{
  "name": "ai-thesis-reading-helper",
  "main": ".open-next/worker.js",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  // Value is already set on the Worker as a Secret and is kept across deploys.
  // Do not put the key in `vars` or in git.
  "secrets": {
    "required": ["OPENAI_API_KEY"]
  }
}
